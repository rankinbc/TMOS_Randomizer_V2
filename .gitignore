# ===================
# TMOS_Strategy_Lab — artifacts + derived data
# ===================
# ROM lives canonically in projects/TMOS_Randomizer_V2/; the Lab copy under
# data/rom/ is a local convenience and should not be committed.
projects/TMOS_Strategy_Lab/data/rom/*.nes
# Parsed ROM snapshots are derived data.
projects/TMOS_Strategy_Lab/data/snapshots/*.json
# Per-run output directories (dated run folders under harness/benchmark/viz).
projects/TMOS_Strategy_Lab/output/*/*/

# ===================
# TMOS_World_Editor — artifacts + derived data
# ===================
projects/TMOS_World_Editor/data/rom/*.nes
projects/TMOS_World_Editor/output/*/*/
.superpowers/

# Generated seeds/reports (contain ROM files — never commit)
output/
